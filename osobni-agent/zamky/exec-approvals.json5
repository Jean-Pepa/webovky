// Seznam příkazů, které agent smí spustit sám. Ověřeno proti OpenClaw 2026.10.8.
//
// Použití (NAVOD.md, krok 6b):
//   openclaw approvals set --file ~/osobni-agent/zamky/exec-approvals.json5
//   openclaw approvals get
//
// Cokoli, co tu není, OpenClaw nespustí, dokud to neschválíš v aplikaci v iPhonu
// (Approvals) nebo v ovládacím panelu. Když nikdo neodpoví, příkaz se zamítne.
// Hlavně: odeslání dotazu ven (agent-resers odeslat) a uložení konceptu mailu
// (agent-mail koncept) tu schválně nejsou, takže je vždycky potvrzuješ ty.
{
  version: 1,
  defaults: { security: "allowlist", ask: "on-miss", askFallback: "deny" },
  agents: {
    main: {
      allowlist: [
        // Maily: jen číst (nové, jednu zprávu, odeslané kvůli tvému stylu).
        { pattern: "~/.local/bin/agent-mail", argPattern: "^(nove|precti|odeslane)( .*)?$" },
        // Rešerše: jen připravit dotaz a prohlížet záznam odeslaného.
        { pattern: "~/.local/bin/agent-resers", argPattern: "^(priprav|log)( .*)?$" },
        // Přepis diktátu a jednání (běží lokálně).
        { pattern: "~/.local/bin/agent-prepis" },
        { pattern: "~/.local/bin/agent-jednani" },
        // Zdraví z náramku: jen výpočty v notebooku, nic se neodesílá.
        { pattern: "~/.local/bin/agent-zdravi", argPattern: "^(den|noc|noci|data|tyden|pokus|kontrola)( .*)?$" },
        // Kalendář: číst, navrhnout, zapsat a smazat hned. Google mu s tímhle přihlášením dovolí
        // měnit jen jeho vlastní kalendář Mozek. Přihlášení (prihlasit) spouštíš ty.
        { pattern: "~/.local/bin/agent-kalendar", argPattern: "^(udalosti|navrh|zapis|smaz)( .*)?$" },
        // Převod PDF na text a dokumentů do Wordu.
        { pattern: "/usr/bin/pdftotext" },
        { pattern: "/usr/bin/pandoc" },
      ],
    },
  },
}
