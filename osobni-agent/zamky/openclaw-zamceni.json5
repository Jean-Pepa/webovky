// Zamčené nastavení OpenClaw pro osobního agenta na notebooku (Ubuntu ve WSL).
// Ověřeno proti OpenClaw 2026.10.9 (`openclaw config validate`).
//
// Použití po `openclaw onboard` (NAVOD.md, krok 6b):
//   openclaw config patch --file ~/osobni-agent/zamky/openclaw-zamceni.json5 --dry-run
//   openclaw config patch --file ~/osobni-agent/zamky/openclaw-zamceni.json5
//
// Soubor se sloučí s tvým nastavením: přepíše jen klíče, které jsou tady.
{
  // Brána poslouchá jen v notebooku. Do iPhonu ji pustíš až v kroku 12, a to jen
  // přes svou soukromou síť Tailscale, nikdy do veřejného internetu.
  gateway: {
    mode: "local",
    bind: "loopback",
  },

  agents: {
    defaults: {
      // Pravidelná kontrola každých 30 minut od 6:00 do 23:00, pokaždé v čisté relaci bez
      // historie chatu. Pokyny jsou v zamky/kontrola.md a do OpenClaw je nahraje
      // zamky/nastav-kontrolu.sh (OpenClaw 2026.10 už nečte HEARTBEAT.md). Nic nikam
      // neposílá, nové věci zapisuje do deníku pod „Čeká na tebe".
      heartbeat: {
        every: "30m",
        target: "none",
        isolatedSession: true,
        activeHours: { start: "06:00", end: "23:00", timezone: "Europe/Prague" },
      },
    },
  },

  // Hledání v paměti jen přes lokální Ollamu. Bez tohoto nastavení by OpenClaw
  // použil OpenAI a při chybě by mohl přejít na jinou cloudovou službu.
  // Kromě deníku a MEMORY.md prohledává i tvoji digitální kopii (ja/) a lidi (lide/).
  memory: {
    search: {
      provider: "ollama",
      model: "embeddinggemma",
      fallback: "none",
      extraPaths: ["ja", "lide"],
    },
  },

  // Noční „snění" (dreaming) vypnuté. Jinak by OpenClaw každou noc sám přepisoval
  // MEMORY.md malým modelem, bez tvé kontroly. Úklid paměti spouštíš ty (krok 6).
  plugins: {
    entries: {
      "memory-core": { config: { dreaming: { enabled: false } } },
    },
  },

  tools: {
    profile: "coding",
    alsoAllow: [],
    // Zakázáno: web a vyhledávání, prohlížeč, ovládání telefonu, posílání zpráv
    // do jiných kanálů, generování médií přes cloud, další agenti a dovednosti,
    // které si agent píše sám (měnily by jeho chování bez tvého souhlasu).
    // Agent si také sám nenaplánuje úlohy (cron) a nespustí aktualizaci OpenClaw
    // (gateway). Naplánované úlohy zakládáš jen ty příkazem openclaw automations.
    // Na internet smí agent jen přes agent-resers, a to po tvém schválení.
    deny: [
      "group:web",
      "group:ui",
      "group:nodes",
      "group:messaging",
      "image_generate",
      "music_generate",
      "video_generate",
      "sessions_spawn",
      "sessions_send",
      "skill_workshop",
      "cron",
      "gateway",
    ],
    // Soubory smí číst a měnit jen ve složce Mozek.
    fs: { workspaceOnly: true },
    // Příkazy jen ze seznamu v exec-approvals.json5. Cokoli jiného čeká na tvé
    // schválení v aplikaci v iPhonu nebo v ovládacím panelu, a když nikdo
    // neodpoví, zamítne se.
    exec: { mode: "ask" },
    elevated: { enabled: false },
    // Hlasové zprávy z iPhonu přepíše lokální Whisper v notebooku (na procesoru,
    // aby nebral grafiku jazykovému modelu; krátká zpráva trvá pár sekund).
    media: {
      audio: { enabled: true },
      models: [
        {
          type: "cli",
          command: "~/.local/bin/agent-prepis",
          args: ["{{AttachmentPath}}"],
          capabilities: ["audio"],
          timeoutSeconds: 600,
        },
      ],
    },
  },

  // Ovládání prohlížeče vypnuté úplně, nejen zakázané jako nástroj.
  browser: { enabled: false },

  // Žádné hlasové odpovědi přes cloud. Microsoft je jinak zapnutý i bez klíče.
  // Odpověď ti iPhone přečte vlastním hlasem v telefonu.
  tts: { auto: "off", providers: { microsoft: { enabled: false } } },

  // Žádná telemetrie ani denní dotaz na aktualizace. Aktualizuješ ručně.
  telemetry: { enabled: false },
  update: { checkOnStart: false },
}
